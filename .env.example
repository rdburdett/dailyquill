# Copy to .env for `npm run publish:store`. Never commit the real .env.
# See PUBLISHING.md for where each value comes from.
CWS_EXTENSION_ID=
CWS_PUBLISHER_ID=
CWS_CLIENT_ID=
CWS_CLIENT_SECRET=
CWS_REFRESH_TOKEN=

# Optional GA4 usage stats, baked into the build (see PUBLISHING.md)
VITE_GA_MEASUREMENT_ID=
VITE_GA_API_SECRET=

# Optional: read GA4 reports with `npm run ga:report` (see PUBLISHING.md)
GA_PROPERTY_ID=
GA_SERVICE_ACCOUNT_JSON=
